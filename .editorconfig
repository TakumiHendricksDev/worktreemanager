root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{rs}]
indent_size = 4
max_line_length = 100

[*.{js,ts,svelte,css,scss,json,jsonc,html,yml,yaml}]
indent_size = 2

[*.toml]
indent_size = 2

[*.md]
# Markdown uses trailing whitespace for hard line breaks.
trim_trailing_whitespace = false

[{justfile,Justfile,*.just}]
indent_size = 4

[Makefile]
indent_style = tab
