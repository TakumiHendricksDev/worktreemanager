# ───────────── Rust / Cargo ─────────────
/target/
**/*.rs.bk
*.pdb
# Cargo.lock IS committed — this is an application, not a library.

# ───────────── Tauri ─────────────
# Regenerated by tauri-build on every build: ACL schemas + mobile projects.
/src-tauri/gen/
# Safety net if someone builds src-tauri outside the workspace.
/src-tauri/target/

# ───────────── Frontend / node ─────────────
/node_modules/
/dist/
/.vite/
*.tsbuildinfo
.svelte-kit/

# ───────────── Local-only overrides & secrets ─────────────
# `*.local.*` is the convention for anything machine-specific.
*.local
*.local.*
!examples/*.local.toml
.env
.env.*
!.env.example

# ───────────── macOS ─────────────
.DS_Store
.AppleDouble
.LSOverride
# Finder's custom-folder-icon file, which is literally `Icon` followed by a carriage
# return. Written as a bracket expression so the CR is matched explicitly.
#
# It was `Icon?` for a long time, and that was a real bug: `?` is a wildcard, git is
# case-insensitive on macOS by default, and a pattern with no slash matches at any
# depth — so it also matched the directory `src-tauri/icons`, silently excluding every
# app icon from the repository. `tauri build` then failed for anyone who cloned it
# with "failed to open icon …/32x32.png", including CI on both platforms.
Icon[]
._*
.Spotlight-V100
.Trashes

# ───────────── Editors / IDE ─────────────
/.idea/
/.vscode/*
!/.vscode/extensions.json
!/.vscode/settings.json.example
*.swp
*.swo

# ───────────── Tooling scratch ─────────────
/.bacon-locations
/coverage/
*.profraw
/.claude/settings.local.json
