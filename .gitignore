# ───────────── Rust / Cargo ─────────────
/target/
**/*.rs.bk
*.pdb
# Cargo.lock IS committed — this is an application, not a library.

# ───────────── Tauri ─────────────
# Regenerated by tauri-build on every build: ACL schemas + mobile projects.
/src-tauri/gen/
# Safety net if someone builds src-tauri outside the workspace.
/src-tauri/target/

# ───────────── Frontend / node ─────────────
/node_modules/
/dist/
/.vite/
*.tsbuildinfo
.svelte-kit/

# ───────────── Local-only overrides & secrets ─────────────
# `*.local.*` is the convention for anything machine-specific.
*.local
*.local.*
!examples/*.local.toml
.env
.env.*
!.env.example

# ───────────── macOS ─────────────
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# ───────────── Editors / IDE ─────────────
/.idea/
/.vscode/*
!/.vscode/extensions.json
!/.vscode/settings.json.example
*.swp
*.swo

# ───────────── Tooling scratch ─────────────
/.bacon-locations
/coverage/
*.profraw
/.claude/settings.local.json
